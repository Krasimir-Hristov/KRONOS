# KRONOS v2 Environment Configuration Template (NEVER commit real secrets)

# Public App URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Security & Encryption (generate 32-byte hex/base64 secrets)
KRONOS_PIN_SECRET=
KRONOS_VAULT_ENCRYPTION_KEY=
CRON_SECRET=

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_URL=
SUPABASE_STORAGE_BUCKET=kronos-vault

# OpenRouter API
OPENROUTER_API_KEY=

# OpenRouter Models — Primary & Fallback Chain
OPENROUTER_JEV_MODEL=typesafe/jev-latest
OPENROUTER_CHAT_FAST_MODEL=deepseek/deepseek-v4.1-flash
OPENROUTER_CHAT_FALLBACK_MODEL=qwen/qwen3.7-flash
OPENROUTER_CHAT_PRO_MODEL=google/gemini-3.5-pro
OPENROUTER_VISION_OCR_MODEL=google/gemini-3.5-flash
OPENROUTER_VISION_FALLBACK_MODEL=qwen/qwen3.6-35b-a3b
OPENROUTER_EMBEDDING_MODEL=openai/text-embedding-3-small
OPENROUTER_STT_MODEL=x-ai/grok-stt-2.0
OPENROUTER_STT_FALLBACK_MODEL=openai/whisper-large-v3-turbo
OPENROUTER_TTS_MODEL=openai/gpt-4o-mini-tts
OPENROUTER_TTS_FALLBACK_MODEL=openai/tts-1
