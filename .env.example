# ==============================================================================
# KRONOS (Κρόνος) — Environment Configuration Template (.env.local)
# ==============================================================================

# 1. App & Security (Required in Production)
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Minimum 32-char random hex/base64 secret for encrypting the 15-min HttpOnly Bank PIN cookie
KRONOS_PIN_SECRET="replace-with-at-least-32-character-random-secret-key"

# 2. Supabase (Database + pgvector + Auth)
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="your-supabase-anon-or-publishable-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"
DATABASE_URL="postgresql://postgres:password@db.your-project-ref.supabase.co:5432/postgres"

# 3. Cloudflare R2 (Zero-Egress Document & Image Vault)
R2_ACCOUNT_ID="your-cloudflare-account-id"
R2_ACCESS_KEY_ID="your-r2-access-key-id"
R2_SECRET_ACCESS_KEY="your-r2-secret-access-key"
R2_BUCKET_NAME="kronos-vault"

# 4. OpenRouter (Single Unified AI Provider: Jev + LLMs + Vision + Nano Banana + Audio)
OPENROUTER_API_KEY="sk-or-v1-your-openrouter-key"

# Optional Model Slug Overrides (defaults defined in src/config/aiModelsConfig.ts)
# OPENROUTER_JEV_MODEL="typesafe/jev-latest"
# OPENROUTER_CHAT_FAST_MODEL="deepseek/deepseek-v4.1-flash"
# OPENROUTER_CHAT_PRO_MODEL="google/gemini-3.8-pro"
# OPENROUTER_VISION_OCR_MODEL="google/gemini-3.8-flash"
# OPENROUTER_IMAGE_FAST_MODEL="google/gemini-3.1-flash-image"
# OPENROUTER_IMAGE_PRO_MODEL="google/gemini-3-pro-image"
# OPENROUTER_EMBEDDING_MODEL="openai/text-embedding-3-small"
# OPENROUTER_STT_MODEL="openai/whisper-large-v3"
# OPENROUTER_TTS_MODEL="openai/gpt-4o-mini-tts"
